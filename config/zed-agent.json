{
  "_comment": "Xcode MCP Bridge Wrapper configuration for Zed Agent",
  "xcode-tools": {
    "_option1_uvx": {
      "command": "uvx",
      "args": ["--from", "mcpbridge-wrapper", "mcpbridge-wrapper"],
      "env": {}
    },
    "_option1b_uvx_web_ui": {
      "command": "uvx",
      "args": [
        "--from",
        "mcpbridge-wrapper[webui]",
        "mcpbridge-wrapper",
        "--web-ui",
        "--web-ui-port",
        "8080"
      ],
      "env": {}
    },
    "_option2_manual": {
      "command": "/Users/YOUR_USERNAME/bin/xcodemcpwrapper",
      "args": [],
      "env": {}
    },
    "_option2b_manual_web_ui": {
      "command": "/Users/YOUR_USERNAME/bin/xcodemcpwrapper",
      "args": ["--web-ui", "--web-ui-port", "8080"],
      "env": {}
    },
    "_option3_local_dev": {
      "command": "/path/to/XcodeMCPWrapper/.venv/bin/mcpbridge-wrapper",
      "args": [],
      "env": {}
    },
    "_option3b_local_dev_web_ui": {
      "command": "/path/to/XcodeMCPWrapper/.venv/bin/mcpbridge-wrapper",
      "args": ["--web-ui", "--web-ui-port", "8080"],
      "env": {}
    }
  }
}
